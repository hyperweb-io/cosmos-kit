{
  "name": "@cosmos-kit/galaxy-station-extension",
  "version": "2.16.1",
  "description": "@cosmos-kit/galaxy-station-extension is the Galaxy Station integration for CosmosKit",
  "author": "Hexxagon",
  "homepage": "https://github.com/hyperweb-io/cosmos-kit#readme",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "lib": "src",
    "test": "__tests__"
  },
  "files": [
    "dist",
    "!CHANGELOG.md",
    "!LICENSE"
  ],
  "scripts": {
    "clean": "makage clean",
    "prepack": "npm run build",
    "build": "rm -rf dist && (tsc -p tsconfig.json || true) && (tsc -p tsconfig.esm.json || true) && cp ../../LICENSE dist/ && cp package.json dist/ && cp README.md dist/ && node -e \"const fs=require('fs'),p=JSON.parse(fs.readFileSync('dist/package.json','utf8'));['main','module','types'].forEach(k=>{if(p[k])p[k]=p[k].replace(/^dist\\//,'')});fs.writeFileSync('dist/package.json',JSON.stringify(p,null,2))\"",
    "build:dev": "makage build --dev",
    "lint": "eslint --ext .tsx,.ts .",
    "format": "eslint --ext .tsx,.ts --fix .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect node_modules/.bin/jest --runInBand"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperweb-io/cosmos-kit"
  },
  "keywords": [
    "cosmos-kit",
    "cosmos",
    "hexxagon",
    "galaxy-station",
    "wallet"
  ],
  "bugs": {
    "url": "https://github.com/hyperweb-io/cosmos-kit/issues"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "dist/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  },
  "dependencies": {
    "@chain-registry/types": "0.46.11",
    "@cosmos-kit/core": "workspace:*",
    "@hexxagon/feather.js": "^1.0.9-beta.8",
    "@hexxagon/station-connector": "^1.0.17",
    "cosmjs-types": "^0.10.1",
    "long": "^5.2.3"
  },
  "peerDependencies": {
    "@cosmjs/amino": ">=0.32.3",
    "@cosmjs/proto-signing": ">=0.32.3"
  },
  "gitHead": "39fe5288455524191eb70ca82de6f2d7e6b3549a",
  "devDependencies": {
    "makage": "^0.1.12"
  }
}
