{
  "name": "@cosmos-kit/web3auth",
  "version": "2.18.1",
  "description": "cosmos-kit wallet connector for Web3Auth",
  "author": "noah@noah.zone",
  "contributors": [
    {
      "name": "Noah Saso"
    }
  ],
  "homepage": "https://github.com/hyperweb-io/cosmos-kit#readme",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "index.js",
  "module": "esm/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "clean": "makage clean",
    "prepack": "npm run build",
    "build": "rm -rf dist && (tsc -p tsconfig.json || true) && (tsc -p tsconfig.esm.json || true) && cp ../../LICENSE dist/ && cp package.json dist/ && cp README.md dist/",
    "lint": "eslint --ext .tsx,.ts .",
    "format": "eslint --ext .tsx,.ts --fix .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect node_modules/.bin/jest --runInBand"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperweb-io/cosmos-kit"
  },
  "keywords": [
    "cosmos-kit",
    "cosmos",
    "leap",
    "wallet"
  ],
  "bugs": {
    "url": "https://github.com/hyperweb-io/cosmos-kit/issues"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "dist/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  },
  "dependencies": {
    "@cosmjs/crypto": "^0.36.2",
    "@cosmjs/encoding": "^0.38.1",
    "@cosmos-kit/core": "workspace:*",
    "@react-native-async-storage/async-storage": "^3.0.1",
    "@toruslabs/eccrypto": "6.2.0",
    "@web3auth/auth": "^10.5.0",
    "@web3auth/modal": "^10.4.0",
    "url": "^0.11.1",
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "@chain-registry/types": "0.46.11",
    "makage": "^0.1.12",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "@chain-registry/types": "0.46.11",
    "@cosmjs/amino": "^0.32.3",
    "@cosmjs/proto-signing": "^0.32.3",
    "@keplr-wallet/cosmos": ">= 0.10",
    "cosmjs-types": "^0.9.0"
  }
}
