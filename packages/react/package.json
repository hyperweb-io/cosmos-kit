{
  "name": "@cosmos-kit/react",
  "version": "2.24.1",
  "description": "cosmos-kit wallet connector",
  "author": "Constructive <developers@constructive.io>",
  "contributors": [
    {
      "name": "Jun Liu"
    },
    {
      "name": "Dan Lynch"
    },
    {
      "name": "Noah Saso"
    },
    {
      "name": "Eliot Baker"
    },
