{
  "name": "@cosmos-kit/ins",
  "version": "2.4.0",
  "description": "cosmos-kit wallet connector",
  "author": "Constructive <developers@constructive.io>",
  "contributors": [
    {
      "name": "Jun Liu"
    },
    {
      "name": "Dan Lynch"
    }
  ],
  "homepage": "https://github.com/hyperweb-io/cosmos-kit#readme",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "lib": "src",
    "test": "__tests__"
  },
  "files": [
    "dist",
    "!CHANGELOG.md",
    "!LICENSE"
  ],
  "scripts": {
    "clean": "makage clean",
    "prepack": "npm run build",
    "build": "makage build",
    "build:dev": "makage build --dev",
    "lint": "eslint --ext .tsx,.ts .",
    "format": "eslint --ext .tsx,.ts --fix .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect node_modules/.bin/jest --runInBand"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperweb-io/cosmos-kit"
  },
  "keywords": [
    "cosmos-kit",
    "cosmos",
    "keplr",
    "leap",
    "cosmostation",
    "wallet"
  ],
  "bugs": {
    "url": "https://github.com/hyperweb-io/cosmos-kit/issues"
  },
  "dependencies": {
    "@babel/runtime": "7.11.2",
    "@chain-registry/types": "^2.0.162",
    "@cosmjs/cosmwasm-stargate": "^0.36.2",
    "chain-registry": "^1.64.13"
  },
  "gitHead": "39fe5288455524191eb70ca82de6f2d7e6b3549a",
  "devDependencies": {
    "makage": "^0.1.12"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "dist/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  }
}
